# ==============================================================================
# Rajdeep Enterprises — Production Environment Variables
# ==============================================================================
# Note: In Vite, variables prefixed with VITE_ are accessible to the browser client.
# Server/backend variables (without VITE_) are strictly accessible in serverless APIs.
# NEVER commit actual passwords, private credentials, or live API secrets to Git.

# --- Domain & Public URL Configuration ---
# Set to your live production custom domain (e.g. https://rajdeepenterprises.in)
VITE_SITE_URL=
SITE_URL=

# --- Google Search Console & SEO Verification ---
# Verification token provided by Google Search Console when claiming your site property
VITE_GOOGLE_SITE_VERIFICATION=

# --- Google Analytics 4 (GA4) / Lead Event Tracking ---
# GA4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank if analytics is not yet created.
VITE_GA_MEASUREMENT_ID=

# --- Server-Side Gmail SMTP Email Notification Service ---
# Server-side ONLY. NEVER prefix with VITE_ or expose to client.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rajdeepenterprises0047@gmail.com
SMTP_PASS=
ALERT_EMAIL_TO=rajdeepenterprises0047@gmail.com

# --- AI Studio / Gemini Key ---
GEMINI_API_KEY=
